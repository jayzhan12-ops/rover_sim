<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover">

  <!-- ============================================================
       DIMENSIONS - change these, everything else follows
       All units are METRES and KILOGRAMS.
       ============================================================ -->
  <xacro:property name="pi_val" value="3.14159265359"/>

  <xacro:property name="chassis_length" value="0.40"/>
  <xacro:property name="chassis_width"  value="0.30"/>
  <xacro:property name="chassis_height" value="0.10"/>
  <xacro:property name="chassis_mass"   value="5.0"/>

  <xacro:property name="wheel_radius"   value="0.06"/>  
  <xacro:property name="wheel_width"    value="0.04"/>
  <xacro:property name="wheel_mass"     value="0.5"/>
  <xacro:property name="wheel_x_offset" value="0.10"/>

  <xacro:property name="caster_radius"  value="0.02"/>
  <xacro:property name="caster_mass"    value="0.1"/>
  <xacro:property name="caster_x_offset" value="-0.15"/>

  <xacro:property name="lidar_radius"   value="0.04"/>
  <xacro:property name="lidar_height"   value="0.04"/>
  <xacro:property name="lidar_mass"     value="0.2"/>

  <!-- Derived: chassis floats above base_link so it clears the ground -->
  <xacro:property name="chassis_z" value="0.03"/>

  <!-- ============================================================
       INERTIA MACROS - standard formulas, do not guess these
       ============================================================ -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi_val/2} 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0"
               iyy="${2*m*r*r/5}" iyz="0"
               izz="${2*m*r*r/5}"/>
    </inertial>
  </xacro:macro>

  <!-- ============================================================
       MATERIALS
       ============================================================ -->
  <material name="blue">  <color rgba="0.2 0.4 0.8 1.0"/></material>
  <material name="black"> <color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="grey">  <color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="red">   <color rgba="0.8 0.2 0.2 1.0"/></material>

  <!-- ============================================================
       BASE
       base_link sits at the height of the drive wheel axles.
       base_footprint is the projection of base_link onto the ground.
       ============================================================ -->
  <link name="base_link"/>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="base_footprint"/>
    <origin xyz="0 0 ${-wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       CHASSIS
       ============================================================ -->
  <link name="chassis">
    <visual>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}"
                       x="${chassis_length}"
                       y="${chassis_width}"
                       z="${chassis_height}"/>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="chassis"/>
    <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       DRIVE WHEELS
       prefix: left / right
       reflect: +1 for left, -1 for right
       Cylinder is rotated pi/2 about X so its axis points along Y.
       ============================================================ -->
  <xacro:macro name="drive_wheel" params="prefix reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi_val/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi_val/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}"
                              r="${wheel_radius}"
                              h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel"/>
      <origin xyz="${wheel_x_offset} ${reflect*(chassis_width/2 + wheel_width/2)} 0"
              rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left"  reflect="1"/>
  <xacro:drive_wheel prefix="right" reflect="-1"/>

  <!-- ============================================================
       CASTER - passive support at the rear
       ============================================================ -->
  <link name="caster_wheel">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_wheel"/>
    <origin xyz="${caster_x_offset} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       LIDAR - mounted on top of the chassis
       ============================================================ -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${lidar_mass}"/>
      <inertia ixx="${lidar_mass*(3*lidar_radius*lidar_radius+lidar_height*lidar_height)/12}" ixy="0" ixz="0"
               iyy="${lidar_mass*(3*lidar_radius*lidar_radius+lidar_height*lidar_height)/12}" iyz="0"
               izz="${lidar_mass*lidar_radius*lidar_radius/2}"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="chassis"/>
    <child  link="lidar_link"/>
    <origin xyz="0.10 0 ${chassis_height/2 + lidar_height/2}" rpy="0 0 0"/>
  </joint>


</robot>
